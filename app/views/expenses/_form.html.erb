<div class="card shadow-sm border-0" style="border-radius:14px;">
  <div class="card-body p-4">

    <% if @expense.errors.any? %>
      <div class="alert alert-danger">
        <h6><%= pluralize(@expense.errors.count, "error") %> prevented this expense from being saved:</h6>
        <ul class="mb-0">
          <% @expense.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: [@trip, @expense] do |form| %>

      <div class="mb-3">
        <%= form.label :title, class: "form-label" %>
        <%= form.text_field :title, class: "form-control", required: true, placeholder: "Dinner, Taxi, Hotel..." %>
      </div>

      <div class="mb-3">
        <%= form.label :amount, class: "form-label" %>
        <%= form.number_field :amount, class: "form-control", required: true, placeholder: "1200" %>
      </div>

      <div class="mb-3">
        <%= form.label :currency, class: "form-label" %>
        <%= form.select :currency, ['RON', 'USD', 'EUR', 'GBP', 'JPY'], {}, class: "form-control", required: true %>
      </div>

      <div class="mb-3">
        <%= form.label :date, class: "form-label" %>
        <%= form.date_field :date, class: "form-control", required: true %>
      </div>

      <div class="mb-3">
        <%= form.label :split_type, class: "form-label" %>
        <%= form.select :split_type, ['equal'], {}, class: "form-control", required: true %>
      </div>

      <div class="mb-3">
        <%= form.label :payer_id, class: "form-label" %>
        <%= form.collection_select :payer_id, 
                                    @trip.users, 
                                    :id, 
                                    :name, { include_blank: true }, 
                                    required: true %>
      </div>

      <div class="d-flex gap-2 mt-4">
        <%= form.submit class: "btn btn-primary" %>

        <%= link_to "Back",
            @expense.persisted? ? trip_expense_path(@trip, @expense) : trip_path(@trip),
            class: "btn btn-secondary ms-auto" %>
      </div>

    <% end %>

  </div>
</div>