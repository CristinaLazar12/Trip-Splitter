<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-6">

      <div class="card shadow-sm border-0" style="border-radius:14px;">
        <div class="card-body p-4">

          <h4 class="fw-bold mb-3">Edit Expense</h4>

          <hr>

          <%= form_with model: [@trip, @expense] do |form| %>

            <div class="mb-3">
              <%= form.label :title, class: "form-label" %>
              <%= form.text_field :title, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= form.label :amount, class: "form-label" %>
              <%= form.number_field :amount, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= form.label :currency, class: "form-label" %>
              <%= form.select :currency, options_for_select(Money::Currency.table.values.map { |c| ["#{c.name} (#{c.iso_code})", c.iso_code] }), required: true %>

              #<%= form.select :currency, ['USD', 'EUR', 'GBP', 'JPY'], {}, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= form.label :date, class: "form-label" %>
              <%= form.date_field :birthday, :default=>Date.today.strftime("%d/%m/%Y"), class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= form.label :split_type, class: "form-label" %>
              <%= form.select :split_type, ['Equal', 'Percentage', 'Custom'], class: "form-control", required: true %>
            </div>

            <div class="d-flex gap-2 mt-4">

              <%= form.submit "Update Expense",
                  class: "btn btn-primary" %>

              <%= link_to "Back",
                  trip_expense_path(@trip, @expense),
                  class: "btn btn-secondary ms-auto" %>

            </div>

          <% end %>

        </div>
      </div>

    </div>

  </div>
</div>