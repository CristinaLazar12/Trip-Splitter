<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow-sm" style="border-radius:12px;">
        <div class="card-body p-4">

          <h3 class="mb-4 text-center">Add Expense</h3>

          <%= form_with model: [@trip, @expense] do |form| %>

            <% if @expense.errors.any? %>
              <div class="alert alert-danger">
                <h6><%= pluralize(@expense.errors.count, "error") %> prevented this expense from being saved:</h6>
                <ul class="mb-0">
                  <% @expense.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :title, class: "form-label" %>
              <%= form.text_field :title, class: "form-control", placeholder: "Dinner, Taxi, Hotel..." %>
            </div>

            <div class="mb-3">
              <%= form.label :amount, class: "form-label" %>
              <%= form.number_field :amount, class: "form-control", placeholder: "1200" %>
            </div>

            <div class="mb-3">
              <%= form.label :currency, class: "form-label" %>
              <%= form.text_field :currency, class: "form-control", placeholder: "RON" %>
            </div>

            <div class="mb-3">
              <%= form.label :date, class: "form-label" %>
              <%= form.datetime_local_field :date, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= form.label :split_type, class: "form-label" %>
              <%= form.text_field :split_type, class: "form-control" %>
            </div>

            <div class="d-grid">
              <%= form.submit "Create Expense", class: "btn btn-primary py-2", style: "border-radius:8px; font-weight:600;" %>
            </div>

          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>