<div class="container-fluid pt-4 px-3">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">

      <!-- TITLE -->
      <div class="text-center mb-4">
        <h1 class="text-2xl font-bold">Edit Trip</h1>
      </div>

      <!-- FORM CARD -->
      <div class="card">
        <div class="card-body">

          <%= form_with model: @trip, local: true do |f| %>

            <!-- NAME -->
            <div class="mb-3">
              <%= f.label :name, class: "form-label" %>
              <%= f.text_field :name, class: "form-control" %>
            </div>

            <!-- DESTINATION -->
            <div class="mb-3">
              <%= f.label :destination, class: "form-label" %>
              <%= f.text_field :destination, class: "form-control" %>
            </div>

            <!-- START DATE -->
            <div class="mb-3">
              <%= f.label :start_date, class: "form-label" %>
              <%= f.date_field :start_date, class: "form-control" %>
            </div>

            <!-- END DATE -->
            <div class="mb-3">
              <%= f.label :end_date, class: "form-label" %>
              <%= f.date_field :end_date, class: "form-control" %>
            </div>

            <!-- BUTTONS -->
            <div class="d-flex justify-content-between mt-4">
              <%= link_to "Cancel",
                    trip_path(@trip),
                    class: "btn btn-outline-secondary" %>

              <%= f.submit "Update Trip",
                    class: "btn btn-primary" %>
            </div>

          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>