<main class="content">
  <div class="container-fluid pt-0 px-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-1">Your Trips</h1>
        <p class="text-muted mb-0">
          Welcome back, <strong><%= current_user.name %></strong> 👋
        </p>
      </div>
      
     <div class="d-flex gap-2">
     <% if false %>
      <a href="#" class="btn btn-light bg-white flex-fill">
        Invite a Friend
      </a>
     <% end %>

      <%= link_to "New Trip",
        new_trip_path,
      class: "btn btn-primary flex-fill" %>
    </div>
  </div>

    <% if @trips.present? %>
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">Your trips</h5>
        </div>

        <div class="card-body">
          <div class="list-group">
            <% @trips.each do |trip| %>
              <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-center">
                  <div class="fw-semibold">
                    <%= trip.name %>
                  </div>

                  <div class="d-flex align-items-center">

                    <div class="d-flex gap-4 me-3 text-end">
                      <div>Your balance</div>
                      <div>You are owed</div>
                      <div>Total spent</div>
                    </div>

                    <div class="d-flex gap-2">
                      <%= link_to "View", trip_path(trip), class: "btn btn-success" %>
                      <%= link_to "Edit", edit_trip_path(trip), class: "btn btn-secondary" %>

                      <%= button_to "Delete",
                        trip_path(trip),
                        method: :delete,
                        data: { confirm: "Are you sure you want to delete this trip?" },
                        form: { class: "m-0" },
                        class: "btn btn-danger" %>
                    </div>
                          
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="card">
        <div class="card-body text-center py-5">
          <h4 class="mb-2">No trips yet ✈️</h4>
          <p class="text-muted mb-4">
            Create your first trip and start splitting expenses with friends.
          </p>
          <%= link_to "Create your first trip", new_trip_path, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>

  </div>
</main>
