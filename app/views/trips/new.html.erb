<h1 class="text-xl font-semibold mb-4">Create a Trip</h1>

<% if @trip&.errors&.any? %>
  <div class="my-4 text-red-600">
    <ul>
      <% @trip.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @trip, class: "contents" do |form| %>
  <div class="my-5">
    <%= form.text_field :name,
      required: true,
      placeholder: "Trip name",
      class: "block shadow rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <%= form.submit "Create trip",
    class: "rounded-md px-4 py-2 bg-black text-white" %>
<% end %>