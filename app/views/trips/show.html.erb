<div class="container-fluid py-4" style="background:#f5f7fb;">
  <div class="container" style="max-width: 1100px;">

    <!-- ================= TOP CARD ================= -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 14px;">
      <div class="card-body p-4">
        <div class="d-flex align-items-start">
          <div>
            <div class="d-flex align-items-center gap-3">
              <h1 class="h3 fw-bold mb-0">🌎 <%= @trip.name %></h1>
                <span class="badge rounded-pill px-3 py-2"
                    style="background:#1f9d57; font-weight:600;">Upcoming</span>
            </div>

            <div class="mt-3 text-secondary">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span style="font-size:18px;">📍</span>
                <span class="fs-6"><%= @trip.name %></span>
              </div>

              <% if false %>
              <div class="d-flex align-items-center gap-2">
                <span style="font-size:18px;">🗓️</span>
                <span class="fs-6">15 May – 20 May 2024</span>
              </div>
              <% end %>

            </div>
          </div>

          <div class="ms-auto d-flex gap-2">
            <a href="<%= new_trip_expense_path(@trip) %>" class="btn btn-primary px-4" style="border-radius:10px; font-weight:600;">
              Add expense
            </a>

          <% if trip_creator?(@trip) %>
            <div class="dropdown">
              <a class="btn btn-light border px-4 dropdown-toggle"
                 href="#"
                 role="button"
                 data-bs-toggle="dropdown"
                 aria-expanded="false"
                 style="border-radius:10px; font-weight:600;">
                Edit
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><%= link_to "Edit trip",
                          edit_trip_path(@trip),
                          class: "dropdown-item" %>
                </li>
                <% if false %>
                <li><a class="dropdown-item" href="#">Archive</a></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= STATS (3 CARDS) ================= -->
    <div class="row g-4 mb-4">
      <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center" style="border-radius:14px;">
          <div class="card-body p-4">
            <div class="text-secondary fw-semibold mb-3">Total spent</div>
            <% if false %>
            <div class="display-6 fw-bold">$1,200.00</div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center" style="border-radius:14px;">
          <div class="card-body p-4">
            <div class="text-secondary fw-semibold mb-3">Your balance</div>
            <% if false %>
            <div class="display-6 fw-bold" style="color:#1f9d57;">$150.00</div>
            <% end %>
            <div class="text-secondary mt-1">You are owed</div>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center" style="border-radius:14px;">
          <div class="card-body p-4">
            <div class="text-secondary fw-semibold">
              People
            </div>

            <div class="fs-4 fw-bold mb-3">
              <%= @trip.users.count %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% if false %>
    <!-- ================= EXPENSES + PARTICIPANTS ================= -->
    <div class="row g-4 mb-4">
      <!-- Expenses (mai lat) -->
      <div class="col-lg-7">
        <div class="card shadow-sm border-0" style="border-radius:14px;">
          <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Expenses</h5>
            <hr class="my-3">

            <div class="py-2">
              <div class="d-flex justify-content-between">
                <div class="fw-semibold">Dinner at Tapas Bar</div>
                <div class="fw-bold">$150.00</div>
              </div>
              <div class="text-secondary small">Paid by You</div>
            </div>

            <hr class="my-3">

            <div class="py-2">
              <div class="d-flex justify-content-between">
                <div class="fw-semibold">Train Tickets</div>
                <div class="fw-bold">$300.00</div>
              </div>
              <div class="text-secondary small">Paid by Sarah</div>
            </div>

            <hr class="my-3">

            <div class="py-2">
              <div class="d-flex justify-content-between">
                <div class="fw-semibold">Museum Entry</div>
                <div class="fw-bold">$80.00</div>
              </div>
              <div class="text-secondary small">Paid by John</div>
            </div>

            <a href="#" class="d-inline-block mt-3 text-decoration-none fw-semibold" style="color:#1d6df2;">
              View all expenses
            </a>
          </div>
        </div>
      </div>
    <% end %>

      <!-- Participants -->
      <div class="col-lg-5">
        <div class="card shadow-sm border-0" style="border-radius:14px;">
          <div class="card-body p-4">

          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">
              Participants (<%= @trip.users.count %>)
            </h5>

            <% if trip_creator?(@trip) %>
              <button type="button"
                class="btn btn-sm btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#defaultModalPrimary">
                + Add participant
              </button>
            <% end %>
          </div>

      <hr class="my-3">
      
      <!-- Mini card pentru fiecare participant, unde apare numele si un avatar colorat -->
      <div class="d-flex flex-wrap gap-3 justify-content-start text-center mb-3">
        <% @trip.users.each do |user| %>
          <div style="width:72px;">
            <div class="mx-auto mb-2 rounded-circle"
              style="width:56px;height:56px;
              background-color:<%= ["#FF6B6B","#4ECDC4","#556270","#C7F464","#FFA69E","#845EC2","#2C73D2","#008E9B"].sample %>;">
            </div>

            <div class="fw-semibold text-center">
              <span><%= user.name %></span>

              <% if user == @trip.creator %>
                <div class="text-muted" style="font-size:11px;">
                  (creator)
                </div>
              <% end %>

              <% if trip_creator?(@trip) %>
              <%= button_to "×",
                  remove_participant_trip_path(@trip, user),
                  method: :delete,
                  form: { class: "d-inline", data: { turbo_confirm: "Remove #{user.name}?" } },
                  class: "btn btn-link p-0 text-muted",
                  style: "font-size:12px;text-decoration:none;line-height:1;" %>
              <% end %>
              </div>
          </div>
        <% end %>
      </div>

      <hr class="my-3">
      
      <% if false %>
      <div class="text-center">
        <div class="text-muted">
          Trip balances will appear here
        </div>
      </div>
      <% end %>

    </div>
  </div>
</div>

<div class="modal fade" id="defaultModalPrimary" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Add a participant to this trip</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with url: add_participant_trip_path(@trip), method: :post do |form| %>
        <div class="modal-body m-3">

          <div class="mb-3">
            <input
              id="participantName"
              name="name"
              type="text"
              class="form-control"
              placeholder="Name"
              required
            >
          </div>

          <div class="mb-3">
            <input
              id="participantEmail"
              name="email_address"
              type="email"
              class="form-control"
              inputmode="email"
              placeholder="Email"
              required
            >
          </div>

        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Close
          </button>

          <button type="submit" class="btn btn-primary">
            Add participant
          </button>
        </div>
      <% end %>

    </div>
  </div>
</div>

    <% if false %>
    <!-- ================= ACTIVITY ================= -->
    <div class="card shadow-sm border-0" style="border-radius:14px;">
      <div class="card-body p-4">
        <h5 class="fw-bold mb-3">Activity</h5>

        <div class="d-flex align-items-start gap-3 py-3 border-top">
          <div class="rounded-circle bg-secondary-subtle" style="width:42px;height:42px;"></div>
          <div class="flex-grow-1">
            <div>
              <span class="fw-semibold">John</span> settled up with you. He paid you back <span class="fw-bold">$50.00</span>.
            </div>
          </div>
          <div class="text-secondary small">Just now</div>
        </div>

        <div class="d-flex align-items-start gap-3 py-3 border-top">
          <div class="rounded-circle bg-secondary-subtle" style="width:42px;height:42px;"></div>
          <div class="flex-grow-1">
            <div>
              <span class="fw-semibold">Sarah</span> added a new expense: <span class="fw-semibold">Train Tickets</span> — <span class="fw-bold">$300.00</span>.
            </div>
          </div>
          <div class="text-secondary small">2 hours ago</div>
        </div>

      </div>
    </div>
    <% end %>
  </div>
</div>

